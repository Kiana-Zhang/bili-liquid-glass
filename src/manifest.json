{
  "manifest_version": 3,
  "name": "Bili Liquid Glass · 氛围光与玻璃",
  "version": "0.1.22",
  "description": "随视频画面扩散的柔和氛围光，以及跟随系统明暗的 Bilibili 观看页玻璃主题。视频帧仅在本机处理。",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Bili Liquid Glass 设置",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "theme.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
